# ── Database (Supabase or any standard PostgreSQL) ──────────────────────────
# The app uses a plain PostgreSQL connection string via postgres.js, so any
# Postgres provider works. For Supabase:
#   Dashboard → Project → Connect → choose a connection string:
#
#   1. Transaction pooler (recommended for serverless/Vercel; port 6543):
#      DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   2. Session pooler (port 5432, IPv4-friendly):
#      DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   3. Direct connection (long-lived servers, and for `npm run db:migrate`):
#      DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# Prepared statements are disabled in the client, so the transaction pooler
# works out of the box. Never commit a real connection string.
DATABASE_URL=

# Vercel Cron authentication. Set the same random value in the deployment.
CRON_SECRET=

# ── JobSpy scraper (Python function at api/jobspy/index.py) ──────────────────
# Shared secret the TS cron uses to authenticate to the Python function. Falls
# back to CRON_SECRET if unset; a dedicated value is preferred. Set the same
# value in the deployment.
JOBSPY_SECRET=
# Optional override for the Python function URL. On Vercel it is derived from
# VERCEL_URL automatically; set this only for local `vercel dev` or a custom
# host, e.g. http://localhost:3000/api/jobspy
JOBSPY_FUNCTION_URL=

# Auth (single-user password gate — planned increment)
AUTH_SECRET=

# ── Supabase Auth + Storage ─────────────────────────────────────────────────
# Dashboard → Project → Connect / Project Settings → API.
# Used by the browser + server auth clients and the private `resumes` bucket.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Claude API (résumé parsing) ─────────────────────────────────────────────
# Structured extraction runs on claude-haiku-4-5. Billed separately from any
# Claude subscription. platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# Optional: email notifications via Resend
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# ── Local assisted autofill (Playwright) ────────────────────────────────────
# Absolute path to a résumé file the local autofill runner uploads to the
# first file input on an application form. Optional; leave unset to fill text
# fields only. Autofill runs only locally and never clicks Submit.
AUTOFILL_RESUME_PATH=
# Set to any value to allow autofill in a non-local (serverless) deployment.
# Leave unset for normal use — autofill is meant to run under `npm run dev`.
ENABLE_LOCAL_AUTOFILL=
